---
import { Picture } from 'astro:assets';
import type { Project } from '../lib/projects';
import { projectPath } from '../lib/projects';
import { localizePath } from '../i18n';

interface Props {
  project: Project;
  index: number;
  /** First card: load eagerly with high priority. */
  priority?: boolean;
}

const { project, index, priority = false } = Astro.props;
const { title, year, studio, cover, coverAlt } = project.entry.data;
const aspect = cover.width / cover.height;
// Cards are ~62vh tall on desktop, so their width is aspect × 62vh.
const sizes = `(max-width: 767px) calc(100vw - 2rem), ${Math.round(aspect * 62)}vh`;
---

<li class="card" data-index={index}>
  <a href={localizePath(projectPath(project), project.lang)}>
    <Picture
      src={cover}
      alt={coverAlt ?? title}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600, 2200].filter((w) => w <= cover.width)}
      sizes={sizes}
      priority={priority}
      loading={priority ? 'eager' : 'lazy'}
      class="card-image"
    />
    <span class="card-caption">
      <span class="card-title">{title}</span>
      <span class="card-year">{year}</span>
      {studio && <span class="card-studio">{studio}</span>}
    </span>
  </a>
</li>

<style>
  .card a {
    display: block;
    text-decoration: none;
  }

  .card-image {
    width: 100%;
    height: auto;
    background: var(--rule);
  }

  .card-caption {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    padding-top: 0.75rem;
  }

  .card-title {
    font-size: var(--step-1);
    font-weight: var(--heading-weight);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--wide);
    line-height: 1.15;
  }

  .card-year {
    font-variant-numeric: tabular-nums;
    color: var(--graphite);
  }

  .card-studio {
    grid-column: 1 / -1;
    font-size: var(--step--1);
    color: var(--graphite);
  }

  .card a:hover .card-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 768px) {
    .card {
      flex: none;
      /* Caption wraps to the image width. */
      width: min-content;
    }

    .card :global(picture),
    .card-image {
      max-width: none;
    }

    .card-image {
      width: auto;
      height: var(--card-h);
    }

    .card-caption {
      max-width: 100%;
    }
  }
</style>
