---
import { Picture } from 'astro:assets';
import type { Project } from '../lib/projects';
import { projectPath } from '../lib/projects';
import { localizePath } from '../i18n';

interface Props {
  project: Project;
  index: number;
  /** First card: load eagerly with high priority. */
  priority?: boolean;
}

const { project, index, priority = false } = Astro.props;
const { title, year, studio, cover, coverAlt, coverPosition } = project.entry.data;

// Every cover sits in the same 3:2 frame: clamp(21rem, 60svh, 36rem) wide on desktop.
const widths = [...new Set([480, 800, 1200, 1600].filter((w) => w < cover.width).concat(Math.min(cover.width, 1600)))];
const sizes = '(max-width: 767px) calc(100vw - 2rem), clamp(21rem, 60svh, 36rem)';
---

<li class="card" style={`--i: ${index}`}>
  <a href={localizePath(projectPath(project), project.lang)}>
    <span class="card-frame" style={`view-transition-name: cover-${project.slug}`}>
      <Picture
        src={cover}
        alt={coverAlt ?? title}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        priority={priority}
        loading={priority ? 'eager' : 'lazy'}
        class="card-image"
        style={coverPosition ? `object-position: ${coverPosition}` : undefined}
        pictureAttributes={{ class: 'card-picture' }}
      />
    </span>
    <span class="card-caption">
      <span class="card-title"><span class="card-title-text">{title}</span></span>
      <span class="card-year">{year}</span>
      {studio && <span class="card-studio">{studio}</span>}
    </span>
  </a>
</li>

<style>
  .card a {
    display: block;
    text-decoration: none;
  }

  .card-frame {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--rule);
  }

  .card :global(.card-picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-image {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .card-caption {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    padding-top: 0.75rem;
  }

  .card-title {
    font-size: var(--step-1);
    font-weight: var(--heading-weight);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--wide);
    line-height: 1.15;
  }

  /* Underline drawn left to right on hover. */
  .card-title-text {
    background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat;
    padding-bottom: 0.1em;
  }

  .card a:hover .card-title-text,
  .card a:focus-visible .card-title-text {
    background-size: 100% 1px;
  }

  .card-year {
    font-variant-numeric: tabular-nums;
    color: var(--graphite);
  }

  .card-studio {
    grid-column: 1 / -1;
    font-size: var(--step--1);
    color: var(--graphite);
  }

  @media (min-width: 768px) {
    .card {
      flex: none;
      width: calc(var(--card-h) * 1.5);
    }

    .card-frame {
      height: var(--card-h);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .card-title-text {
      transition: background-size var(--dur-med) var(--ease-out);
    }

    /* Slightly oversized so the parallax never shows the frame edge. */
    .card-image {
      transform: scale(1.08);
      transition: transform var(--dur-long) var(--ease-out);
    }

    .card a:hover .card-image {
      transform: scale(1.12);
    }

    /* Intro: cards slide in after the name starts drawing. */
    :global(:root[data-intro='play']) .card {
      animation: card-in var(--dur-long) var(--ease-out) both;
      animation-delay: calc(600ms + var(--i) * 90ms);
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateX(40px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Parallax tied to the gallery's horizontal scroll. */
  @keyframes card-parallax {
    from {
      transform: translateX(-16px);
    }
    to {
      transform: translateX(16px);
    }
  }

  @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
    @supports (animation-timeline: view()) {
      .card :global(.card-picture) {
        animation: card-parallax linear both;
        animation-timeline: view(inline);
      }
    }
  }
</style>
