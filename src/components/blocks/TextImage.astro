---
import type { ImageMetadata } from 'astro';
import Figure from './Figure.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  html: string;
  side: 'left' | 'right';
}

const { image, alt, caption, html, side } = Astro.props;
---

<div class:list={['text-image', `text-${side}`]}>
  <div class="prose text" set:html={html} />
  <Figure image={image} alt={alt} caption={caption} sizes="(max-width: 767px) 100vw, 55vw" class="image" />
</div>

<style>
  .text-image {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .text-image {
      grid-template-columns: 5fr 7fr;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }

    .text-right {
      grid-template-columns: 7fr 5fr;
    }

    .text-right .text {
      order: 2;
    }
  }
</style>
