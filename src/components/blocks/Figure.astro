---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  sizes: string;
  class?: string;
  /** Position in a row, used to stagger the scroll reveal. */
  n?: number;
}

const { image, alt, caption, sizes, class: className, n = 0 } = Astro.props;
// Never above the source width; always include the source width itself.
const widths = [...new Set([480, 800, 1200, 1600, 2000, 2600].filter((w) => w < image.width).concat(Math.min(image.width, 2600)))];
---

<figure class:list={['figure', 'enter', className]} style={`--natural-width: ${image.width}px; --n: ${n}`}>
  <Picture src={image} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 0;
  }

  .figure :global(img) {
    width: 100%;
    /* Low-resolution sources are never stretched past their own size. */
    max-width: min(100%, var(--natural-width));
    height: auto;
    background: var(--rule);
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--graphite);
  }
</style>
