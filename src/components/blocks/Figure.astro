---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  sizes: string;
  class?: string;
}

const { image, alt, caption, sizes, class: className } = Astro.props;
const widths = [480, 800, 1200, 1600, 2000, 2600].filter((w) => w <= image.width);
if (!widths.length) widths.push(image.width);
---

<figure class:list={['figure', className]}>
  <Picture src={image} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 0;
  }

  .figure :global(img) {
    width: 100%;
    height: auto;
    background: var(--rule);
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--graphite);
  }
</style>
