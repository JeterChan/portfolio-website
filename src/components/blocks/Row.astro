---
import type { BlockImage } from '../../lib/blocks';
import Figure from './Figure.astro';

interface Props {
  images: BlockImage[];
  caption?: string;
}

const { images, caption } = Astro.props;
const columns = images.length;
---

<figure class="row" style={`--columns: ${columns}`}>
  <div class="row-images">
    {images.map((img, n) => <Figure image={img.image} alt={img.alt} n={n} sizes={`(max-width: 767px) 100vw, ${Math.round(90 / columns)}vw`} />)}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .row {
    margin: 0;
  }

  .row-images {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .row-images {
      grid-template-columns: repeat(var(--columns), 1fr);
      gap: clamp(1rem, 2vw, 2rem);
      align-items: start;
    }
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--graphite);
  }
</style>
