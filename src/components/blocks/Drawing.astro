---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  lang: Locale;
}

const { image, alt, caption, lang } = Astro.props;
const t = useTranslations(lang);

// Large version for the zoom viewer, sharp enough to read line weights.
const zoomWidth = Math.min(image.width, 4000);
const zoomHeight = Math.round((image.height * zoomWidth) / image.width);
const zoom = await getImage({ src: image, width: zoomWidth, format: 'webp', quality: 90 });
const widths = [800, 1200, 1600, 2400].filter((w) => w <= image.width);
---

<figure class="drawing reveal">
  <a
    class="drawing-link"
    href={zoom.src}
    data-pswp-width={zoomWidth}
    data-pswp-height={zoomHeight}
    aria-label={`${t('project.enlarge')}: ${caption ?? alt}`}
    data-cursor-label={t('project.enlargeCursor')}
  >
    <Picture src={image} alt={alt} formats={['webp']} widths={widths.length ? widths : [image.width]} sizes="(max-width: 767px) 100vw, 90vw" loading="lazy" />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .drawing {
    margin: 0;
    padding: clamp(0.75rem, 2vw, 2rem);
    background: #fff;
    border: 1px solid var(--rule);
  }

  .drawing-link {
    position: relative;
    display: block;
    cursor: zoom-in;
  }

  /* Blue-pencil frame traced edge by edge on hover. */
  .drawing-link::after {
    content: '';
    position: absolute;
    inset: -0.5rem;
    pointer-events: none;
    background:
      linear-gradient(var(--accent), var(--accent)) left top / 0 2px no-repeat,
      linear-gradient(var(--accent), var(--accent)) right top / 2px 0 no-repeat,
      linear-gradient(var(--accent), var(--accent)) right bottom / 0 2px no-repeat,
      linear-gradient(var(--accent), var(--accent)) left bottom / 2px 0 no-repeat;
  }

  @media (hover: hover) and (pointer: fine) {
    .drawing-link:hover::after,
    .drawing-link:focus-visible::after {
      background-size:
        100% 2px,
        2px 100%,
        100% 2px,
        2px 100%;
    }

    .drawing-link {
      cursor: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawing-link::after {
      transition: background-size var(--dur-long) var(--ease-in-out);
    }
  }

  .drawing :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 1rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--ink);
    font-size: var(--step--1);
    font-weight: var(--heading-weight);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--wide);
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '[data-project-body]',
    children: 'a.drawing-link',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 1,
    wheelToZoom: true,
    initialZoomLevel: 'fit',
    secondaryZoomLevel: 1,
    maxZoomLevel: 3,
    showHideAnimationType: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'none' : 'zoom',
    showAnimationDuration: 350,
    hideAnimationDuration: 300,
    easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)',
  });
  lightbox.init();

  // "Enlarge" label that follows the pointer over drawings (mouse and trackpad only).
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const label = document.createElement('div');
    label.className = 'cursor-label';
    label.setAttribute('aria-hidden', 'true');
    document.body.append(label);

    document.querySelectorAll<HTMLElement>('a.drawing-link').forEach((link) => {
      link.addEventListener('pointerenter', () => {
        label.textContent = link.dataset.cursorLabel ?? '';
        label.classList.add('is-visible');
      });
      link.addEventListener('pointerleave', () => label.classList.remove('is-visible'));
      link.addEventListener('pointermove', (event) => {
        label.style.transform = `translate(${event.clientX + 14}px, ${event.clientY + 14}px)`;
      });
      link.addEventListener('click', () => label.classList.remove('is-visible'));
    });
  }
</script>

<style is:global>
  .cursor-label {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    padding: 0.3rem 0.55rem;
    background: var(--accent);
    color: #fff;
    font-size: var(--step--1);
    font-weight: 600;
    pointer-events: none;
    opacity: 0;
  }

  .cursor-label.is-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor-label {
      transition: opacity var(--dur-short) var(--ease-out);
    }
  }

  .pswp {
    --pswp-bg: #fff;
    --pswp-icon-color: #000;
    --pswp-icon-color-secondary: #fff;
    --pswp-icon-stroke-color: #fff;
  }
</style>
