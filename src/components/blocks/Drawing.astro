---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  lang: Locale;
}

const { image, alt, caption, lang } = Astro.props;
const t = useTranslations(lang);

// Large version for the zoom viewer, sharp enough to read line weights.
const zoomWidth = Math.min(image.width, 4000);
const zoomHeight = Math.round((image.height * zoomWidth) / image.width);
const zoom = await getImage({ src: image, width: zoomWidth, format: 'webp', quality: 90 });
// Never above the source width; always include the source width itself.
const widths = [...new Set([800, 1200, 1600, 2400].filter((w) => w < image.width).concat(Math.min(image.width, 2400)))];
---

<figure class="drawing enter" style={`--natural-width: ${image.width}px`}>
  <a
    class="drawing-link"
    href={zoom.src}
    data-pswp-width={zoomWidth}
    data-pswp-height={zoomHeight}
    aria-label={`${t('project.enlarge')}: ${caption ?? alt}`}
    data-cursor-label={t('project.enlargeCursor')}
  >
    <Picture
      src={image}
      alt={alt}
      formats={['webp']}
      widths={widths}
      sizes={`(max-width: 767px) calc(100vw - 2rem), min(90vw, ${image.width}px)`}
      loading="lazy"
    />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .drawing {
    --sheet-pad: clamp(0.75rem, 2vw, 2rem);
    /* The white sheet hugs the drawing: never wider than its source pixels. */
    width: min(100%, calc(var(--natural-width) + 2 * var(--sheet-pad) + 2px));
    margin: 0;
    padding: var(--sheet-pad);
    background: #fff;
    border: 1px solid var(--rule);
  }

  .drawing-link {
    position: relative;
    display: block;
    cursor: zoom-in;
  }

  /* Blue-pencil frame traced edge by edge on hover. */
  .drawing-link::after {
    content: '';
    position: absolute;
    inset: -0.5rem;
    pointer-events: none;
    background:
      linear-gradient(var(--accent), var(--accent)) left top / 0 2px no-repeat,
      linear-gradient(var(--accent), var(--accent)) right top / 2px 0 no-repeat,
      linear-gradient(var(--accent), var(--accent)) right bottom / 0 2px no-repeat,
      linear-gradient(var(--accent), var(--accent)) left bottom / 2px 0 no-repeat;
  }

  @media (hover: hover) and (pointer: fine) {
    .drawing-link:hover::after,
    .drawing-link:focus-visible::after {
      background-size:
        100% 2px,
        2px 100%,
        100% 2px,
        2px 100%;
    }

    .drawing-link {
      cursor: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawing-link::after {
      transition: background-size var(--dur-long) var(--ease-in-out);
    }
  }

  .drawing :global(img) {
    width: 100%;
    max-width: var(--natural-width);
    height: auto;
  }

  figcaption {
    margin-top: 1rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--ink);
    font-size: var(--step--1);
    font-weight: var(--heading-weight);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--wide);
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '[data-project-body]',
    children: 'a.drawing-link',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 1,
    wheelToZoom: true,
    initialZoomLevel: 'fit',
    secondaryZoomLevel: 1,
    maxZoomLevel: 3,
    showHideAnimationType: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'none' : 'zoom',
    showAnimationDuration: 350,
    hideAnimationDuration: 300,
    easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)',
  });
  lightbox.init();

  // Mouse and trackpad only: an animated ring cursor over drawings.
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const cursor = document.createElement('div');
    cursor.className = 'drawing-cursor';
    cursor.setAttribute('aria-hidden', 'true');
    cursor.innerHTML = '<span class="drawing-cursor-ring"><span class="drawing-cursor-plus"></span></span><span class="drawing-cursor-label"></span>';
    const label = cursor.querySelector<HTMLElement>('.drawing-cursor-label')!;
    document.body.append(cursor);

    // Ease the ring toward the pointer; stop the loop once it has caught up.
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    let frame = 0;
    const place = () => {
      cursor.style.transform = `translate3d(${current.x}px, ${current.y}px, 0)`;
    };
    const follow = () => {
      current.x += (target.x - current.x) * 0.2;
      current.y += (target.y - current.y) * 0.2;
      place();
      if (Math.abs(target.x - current.x) > 0.1 || Math.abs(target.y - current.y) > 0.1) {
        frame = requestAnimationFrame(follow);
      } else {
        frame = 0;
      }
    };
    const moveTo = (x: number, y: number, snap = false) => {
      target.x = x;
      target.y = y;
      if (snap || reduced.matches) {
        current.x = x;
        current.y = y;
        place();
      } else if (!frame) {
        frame = requestAnimationFrame(follow);
      }
    };

    const hide = () => cursor.classList.remove('is-visible', 'is-pressed');

    document.querySelectorAll<HTMLAnchorElement>('a.drawing-link').forEach((link) => {
      link.addEventListener('pointerenter', (event) => {
        label.textContent = link.dataset.cursorLabel ?? '';
        moveTo(event.clientX, event.clientY, true);
        cursor.classList.add('is-visible');
      });
      link.addEventListener('pointermove', (event) => moveTo(event.clientX, event.clientY));
      link.addEventListener('pointerdown', () => cursor.classList.add('is-pressed'));
      link.addEventListener('pointerup', () => cursor.classList.remove('is-pressed'));
      link.addEventListener('pointerleave', hide);
      link.addEventListener('click', hide);
    });
  }
</script>

<style is:global>
  /* Ring cursor: positioned by transform on the outer box, scaled on the inner ring. */
  .drawing-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    pointer-events: none;
  }

  .drawing-cursor-ring {
    position: absolute;
    top: -36px;
    left: -36px;
    width: 72px;
    height: 72px;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    background: rgb(36 64 200 / 0.08);
    opacity: 0;
    transform: scale(0.15);
  }

  /* The "+" at the centre. */
  .drawing-cursor-plus::before,
  .drawing-cursor-plus::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--accent);
    transform: translate(-50%, -50%);
  }

  .drawing-cursor-plus::before {
    width: 14px;
    height: 1.5px;
  }

  .drawing-cursor-plus::after {
    width: 1.5px;
    height: 14px;
  }

  .drawing-cursor-plus,
  .drawing-cursor-label {
    opacity: 0;
  }

  .drawing-cursor-label {
    position: absolute;
    top: 44px;
    left: 0;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .drawing-cursor.is-visible .drawing-cursor-ring {
    opacity: 1;
    transform: scale(1);
  }

  .drawing-cursor.is-visible.is-pressed .drawing-cursor-ring {
    transform: scale(0.85);
  }

  .drawing-cursor.is-visible .drawing-cursor-plus,
  .drawing-cursor.is-visible .drawing-cursor-label {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawing-cursor-ring {
      transition:
        transform 250ms var(--ease-out),
        opacity 250ms var(--ease-out);
    }

    .drawing-cursor.is-visible .drawing-cursor-ring {
      transition-duration: 350ms;
    }

    .drawing-cursor-plus,
    .drawing-cursor-label {
      transition: opacity 200ms var(--ease-out);
    }

    .drawing-cursor.is-visible .drawing-cursor-plus,
    .drawing-cursor.is-visible .drawing-cursor-label {
      transition-delay: 120ms;
    }
  }

  .pswp {
    --pswp-bg: #fff;
    --pswp-icon-color: #000;
    --pswp-icon-color-secondary: #fff;
    --pswp-icon-stroke-color: #fff;
  }
</style>
