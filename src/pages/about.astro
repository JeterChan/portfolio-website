---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPortfolioPdf } from '../lib/pdf';
import { useTranslations } from '../i18n';

const lang = 'en';
const t = useTranslations(lang);
const profile = await getEntry('profile', lang);
if (!profile) throw new Error(`缺少 content/profile/index.${lang}.md`);
const { Content } = await render(profile);
const { name, role, location, email, links } = profile.data;
const pdf = getPortfolioPdf();
---

<Base lang={lang} section="about" title={t('about.title')}>
  <div class="about">
    <header class="intro">
      <h1>{name}</h1>
      {(role || location) && <p class="role">{[role, location].filter(Boolean).join(', ')}</p>}
    </header>

    <div class="prose cv">
      <Content />
    </div>

    <aside class="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading">{t('about.contact')}</h2>
      <ul>
        {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
        {links.map((link) => <li><a href={link.url} rel="me noopener" target="_blank">{link.label}</a></li>)}
      </ul>
      {
        pdf && (
          <a class="pdf" href={pdf.href} download>
            {t('pdf.download')} <span>(PDF, {pdf.size})</span>
          </a>
        )
      }
    </aside>
  </div>
</Base>

<style>
  .about {
    display: grid;
    gap: 3rem;
    padding: clamp(2rem, 6vw, 5rem) var(--gutter) 5rem;
  }

  h1 {
    font-size: var(--display-size);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--wide);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
  }

  .role {
    margin-top: 0.75rem;
    font-size: var(--step-1);
    color: var(--graphite);
  }

  .cv :global(p:first-child) {
    font-size: var(--step-1);
    line-height: 1.4;
  }

  .contact h2 {
    font-size: var(--step-0);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--wide);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 0.75rem;
  }

  .contact ul {
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    line-height: 1.9;
  }

  .pdf {
    display: inline-block;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--ink);
    text-decoration: none;
    font-weight: var(--heading-weight);
  }

  .pdf span {
    font-weight: 400;
    color: var(--graphite);
  }

  .pdf:hover {
    background: var(--ink);
    color: var(--sheet);
  }

  .pdf:hover span {
    color: inherit;
  }

  @media (min-width: 768px) {
    .about {
      grid-template-columns: 7fr 4fr;
      column-gap: clamp(2rem, 6vw, 6rem);
    }

    .intro {
      grid-column: 1 / -1;
    }

    .contact {
      position: sticky;
      top: 2rem;
      align-self: start;
    }
  }
</style>
