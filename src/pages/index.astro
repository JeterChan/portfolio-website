---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import { getEntry } from 'astro:content';
import { useTranslations } from '../i18n';

const lang = 'en';
const t = useTranslations(lang);
const projects = await getProjects(lang);
const name = (await getEntry('profile', lang))?.data.name ?? '';
// First guess at the text width (Archivo wide, font-size 100); refined in the browser.
const nameWidth = Math.round(name.length * 72);
---

<Base lang={lang} section="work" fullBleed>
  <script
    slot="head"
    is:inline
    set:html={`try{var m=matchMedia('(prefers-reduced-motion: no-preference)').matches;if(m&&!sessionStorage.getItem('intro-seen')){document.documentElement.dataset.intro='play';sessionStorage.setItem('intro-seen','1')}}catch(e){}`}
  />
  <h1 class="visually-hidden">{name}: {t('home.title')}</h1>
  <div class="home">
  <div class="name-wrap">
    <svg class="name" role="img" aria-label={name} viewBox={`0 -80 ${nameWidth} 100`} data-name>
      <text x="0" y="0">{name}</text>
    </svg>
  </div>
  <div class="gallery" data-gallery>
    <ol class="track" data-track>
      {projects.map((project, i) => <ProjectCard project={project} index={i} priority={i === 0} />)}
    </ol>
  </div>

  {
    projects.length > 1 && (
      <nav class="scalebar" aria-label={t('home.progress')} data-scalebar>
        <div class="scalebar-bar">
          {projects.map((project, i) => (
            <button
              type="button"
              class="scalebar-segment"
              data-target={i}
              aria-label={`${t('home.goTo')} ${project.entry.data.title}`}
            />
          ))}
          <span class="scalebar-marker" data-marker aria-hidden="true" />
        </div>
        <ol class="scalebar-ticks" aria-hidden="true">
          {Array.from({ length: projects.length + 1 }, (_, i) => (
            <li>{i}</li>
          ))}
        </ol>
      </nav>
    )
  }
  </div>
</Base>

<style>
  .gallery {
    --card-h: clamp(14rem, 40svh, 24rem);
    padding: 1.5rem var(--gutter) 2rem;
  }

  /* Name at the top, the work resting along the bottom of the viewport. */
  .home {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-h));
  }

  .gallery {
    margin-top: auto;
  }

  .name-wrap {
    padding: clamp(1rem, 4svh, 3rem) var(--gutter) 0;
  }

  .name {
    display: block;
    height: clamp(2.75rem, 1rem + 7vw, 7rem);
    width: auto;
    max-width: 100%;
    overflow: visible;
  }

  .name text {
    font-family: var(--font-display);
    font-size: 100px;
    font-weight: var(--display-weight);
    font-variation-settings: 'wdth' var(--wide);
    letter-spacing: -0.01em;
    fill: var(--ink);
    stroke: var(--ink);
    stroke-width: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root[data-intro='play']) .name text {
      stroke-width: 1.2;
      stroke-dasharray: 900;
      animation:
        name-draw 1.2s var(--ease-in-out) both,
        name-fill 0.5s 1s var(--ease-out) both;
    }
  }

  @keyframes name-draw {
    from {
      stroke-dashoffset: 900;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes name-fill {
    from {
      fill: transparent;
    }
    to {
      fill: var(--ink);
    }
  }

  .track {
    display: grid;
    gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scalebar {
    display: none;
  }

  @media (min-width: 768px) {
    .gallery {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      padding-bottom: 1rem;
    }

    .gallery::-webkit-scrollbar {
      display: none;
    }

    .track {
      display: flex;
      align-items: flex-start;
      gap: clamp(2rem, 4vw, 4.5rem);
      width: max-content;
      /* Let the last card reach the left edge. */
      padding-right: var(--gutter);
    }

    /* Scale bar: one segment per project, marker shows scroll position. */
    .scalebar {
      display: block;
      width: min(24rem, 40vw);
      margin: 0 var(--gutter) 1.5rem;
    }

    .scalebar-bar {
      position: relative;
      display: flex;
      height: 0.5rem;
      border: 1px solid var(--ink);
    }

    .scalebar-segment {
      flex: 1;
      padding: 0;
      border: 0;
      background: var(--sheet);
      cursor: pointer;
    }

    .scalebar-segment:nth-child(odd) {
      background: var(--ink);
    }

    .scalebar-segment:hover {
      background: var(--accent);
    }

    .scalebar-segment:focus-visible {
      outline-offset: 4px;
    }

    .scalebar-marker {
      position: absolute;
      top: -0.7rem;
      left: 0;
      width: 0;
      height: 0;
      border-left: 0.35rem solid transparent;
      border-right: 0.35rem solid transparent;
      border-top: 0.5rem solid var(--accent);
      transform: translateX(calc(var(--progress, 0) * (min(24rem, 40vw) - 2px) - 50%));
      pointer-events: none;
    }

    @supports (animation-timeline: scroll()) {
      :global(main) {
        timeline-scope: --gallery;
      }

      .gallery {
        scroll-timeline: --gallery inline;
      }

      .scalebar-marker {
        animation: scalebar-marker linear both;
        animation-timeline: --gallery;
      }
    }

    .scalebar-ticks {
      display: flex;
      justify-content: space-between;
      margin: 0.3rem 0 0;
      padding: 0;
      list-style: none;
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
      color: var(--graphite);
    }

    .scalebar-ticks li {
      width: 0;
      display: flex;
      justify-content: center;
    }
  }
</style>

<style>
  @keyframes scalebar-marker {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(calc(min(24rem, 40vw) - 2px - 50%));
    }
  }
</style>

<script>
  // Fit the name's viewBox to the rendered text once the web font is ready.
  const nameSvg = document.querySelector<SVGSVGElement>('[data-name]');
  const fitName = () => {
    const box = nameSvg?.querySelector('text')?.getBBox();
    if (nameSvg && box && box.width) nameSvg.setAttribute('viewBox', `${box.x} ${box.y} ${box.width} ${box.height}`);
  };
  document.fonts.ready.then(fitName);

  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const scalebar = document.querySelector<HTMLElement>('[data-scalebar]');
  const desktop = window.matchMedia('(min-width: 768px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (gallery) {
    const cards = Array.from(gallery.querySelectorAll<HTMLElement>('.card'));
    const maxScroll = () => gallery.scrollWidth - gallery.clientWidth;
    const behavior = (): ScrollBehavior => (reducedMotion.matches ? 'auto' : 'smooth');

    // Vertical mouse wheel moves the gallery sideways. Horizontal trackpad
    // gestures are left alone, and the page takes over at either end.
    gallery.addEventListener(
      'wheel',
      (event) => {
        if (!desktop.matches || event.ctrlKey) return;
        if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
        const delta = event.deltaMode === 1 ? event.deltaY * 16 : event.deltaY;
        const atStart = gallery.scrollLeft <= 0 && delta < 0;
        const atEnd = gallery.scrollLeft >= maxScroll() - 1 && delta > 0;
        if (atStart || atEnd) return;
        event.preventDefault();
        gallery.scrollLeft += delta;
      },
      { passive: false },
    );

    const scrollToCard = (index: number, focus = false) => {
      const card = cards[Math.max(0, Math.min(cards.length - 1, index))];
      if (!card) return;
      gallery.scrollTo({ left: card.offsetLeft - gallery.offsetLeft - parseFloat(getComputedStyle(gallery).paddingLeft), behavior: behavior() });
      if (focus) card.querySelector('a')?.focus({ preventScroll: true });
    };

    const currentIndex = () => {
      const edge = gallery.scrollLeft;
      let index = 0;
      cards.forEach((card, i) => {
        if (card.offsetLeft - gallery.offsetLeft <= edge + 40) index = i;
      });
      return index;
    };

    // Keyboard: arrow keys step between projects; a focused card is brought into view.
    document.addEventListener('keydown', (event) => {
      if (!desktop.matches || event.altKey || event.metaKey || event.ctrlKey) return;
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      const active = document.activeElement;
      if (active && ['INPUT', 'TEXTAREA', 'SELECT'].includes(active.tagName)) return;
      event.preventDefault();
      const focusedCard = cards.findIndex((card) => card.contains(active));
      const from = focusedCard >= 0 ? focusedCard : currentIndex();
      scrollToCard(from + (event.key === 'ArrowRight' ? 1 : -1), true);
    });

    gallery.addEventListener('focusin', (event) => {
      if (!desktop.matches) return;
      const card = (event.target as HTMLElement).closest<HTMLElement>('.card');
      card?.scrollIntoView({ behavior: behavior(), inline: 'nearest', block: 'nearest' });
    });

    if (scalebar) {
      const update = () => {
        const max = maxScroll();
        scalebar.style.setProperty('--progress', String(max > 0 ? gallery.scrollLeft / max : 0));
      };
      gallery.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();

      scalebar.querySelectorAll<HTMLButtonElement>('[data-target]').forEach((button) => {
        button.addEventListener('click', () => scrollToCard(Number(button.dataset.target)));
      });
    }
  }
</script>
