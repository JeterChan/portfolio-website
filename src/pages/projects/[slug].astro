---
import type { GetStaticPaths } from 'astro';
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/blocks/Figure.astro';
import Drawing from '../../components/blocks/Drawing.astro';
import TextImage from '../../components/blocks/TextImage.astro';
import Row from '../../components/blocks/Row.astro';
import { getProjects, projectPath, type Project } from '../../lib/projects';
import { parseBlocks } from '../../lib/blocks';
import { localizePath, useTranslations } from '../../i18n';

export const getStaticPaths = (async () => {
  const projects = await getProjects('en');
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      previous: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  previous: Project;
  next: Project;
}

const { project, previous, next } = Astro.props;
const { lang } = project;
const t = useTranslations(lang);
const data = project.entry.data;
const blocks = parseBlocks(project);

const collaborators = Array.isArray(data.collaborators) ? data.collaborators.join(', ') : data.collaborators;
const facts = [
  [t('project.year'), String(data.year)],
  [t('project.studio'), data.studio],
  [t('project.location'), data.location],
  [t('project.type'), data.type],
  [t('project.instructor'), data.instructor],
  [t('project.collaborators'), collaborators],
].filter((fact): fact is [string, string] => Boolean(fact[1]));

const cover = data.cover;
const heroWidths = [...new Set([800, 1200, 1600, 2000, 2600].filter((w) => w < cover.width).concat(Math.min(cover.width, 2600)))];
const og = await getImage({ src: data.cover, width: 1200, format: 'jpg', quality: 80 });
const showNeighbours = previous.slug !== project.slug;
---

<Base lang={lang} section="work" title={data.title} description={data.summary} ogImage={og.src}>
  <script
    slot="head"
    is:inline
    set:html={`try{if(matchMedia('(prefers-reduced-motion: no-preference)').matches&&'IntersectionObserver' in window){var r=document.documentElement;r.classList.add('js-motion');setTimeout(function(){if(!window.__motionReady)r.classList.remove('js-motion')},3000)}}catch(e){}`}
  />
  <div class="read-progress" aria-hidden="true" data-read-progress><span></span></div>
  <section class="hero" aria-labelledby="project-title">
    <div
      class="hero-media"
      style={`--natural-width: ${cover.width}px; --ratio: ${(cover.width / cover.height).toFixed(4)}; view-transition-name: cover-${project.slug}`}
    >
      <Picture
        src={cover}
        alt={data.coverAlt ?? data.title}
        formats={['avif', 'webp']}
        widths={heroWidths}
        sizes={`(max-width: 767px) calc(100vw - 2rem), ${cover.width}px`}
        priority
        class="hero-image"
        pictureAttributes={{ class: 'hero-picture' }}
      />
    </div>
    <div class="hero-caption">
      <h1 id="project-title" data-lines>{data.title}</h1>
      {data.summary && <p class="summary" data-lines>{data.summary}</p>}
    </div>
  </section>

  <article class="project">
    <header class="title-block">
      <dl class="facts" data-facts>
        {
          facts.map(([label, value], i) => (
            <div style={`--i: ${i}`}>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class="project-body" data-project-body>
      {
        blocks.map((block) => {
          switch (block.type) {
            case 'text':
              return <div class="prose block-text" set:html={block.html} />;
            case 'full':
              return <Figure image={block.image} alt={block.alt} caption={block.caption} sizes="100vw" class="block-full" />;
            case 'drawing':
              return <Drawing image={block.image} alt={block.alt} caption={block.caption} lang={lang} />;
            case 'row':
              return <Row images={block.images} caption={block.caption} />;
            case 'text-image':
              return <TextImage image={block.image} alt={block.alt} caption={block.caption} html={block.html} side={block.side} />;
          }
        })
      }
    </div>

    <nav class="project-nav" aria-label="Projects">
      {
        showNeighbours && (
          <a class="prev" href={localizePath(projectPath(previous), lang)} rel="prev">
            <span class="nav-label">{t('project.previous')}</span>
            <span class="nav-title">{previous.entry.data.title}</span>
          </a>
        )
      }
      <a class="all" href={localizePath('/', lang)}>{t('project.allWork')}</a>
      {
        showNeighbours && (
          <a class="next" href={localizePath(projectPath(next), lang)} rel="next">
            <span class="nav-label">{t('project.next')}</span>
            <span class="nav-title">{next.entry.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  /* Cover at its natural size or smaller, never upscaled (image-fidelity). */
  .hero {
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter) 0;
  }

  .hero-media {
    width: min(100%, var(--natural-width), calc(75svh * var(--ratio)));
    aspect-ratio: var(--ratio);
    background: var(--rule);
  }

  .hero :global(.hero-picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    width: 100%;
    height: 100%;
  }

  .hero-caption {
    display: grid;
    gap: 1rem;
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }

  @media (min-width: 768px) {
    .hero-caption {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      column-gap: clamp(2rem, 5vw, 5rem);
    }
  }

  .project {
    padding: clamp(2rem, 6vw, 5rem) var(--gutter) 0;
  }

  /* Title block: set out like the title block of a drawing sheet. */
  .title-block {
    display: grid;
    gap: 1.5rem;
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  h1 {
    font-size: clamp(2rem, 1rem + 3vw, 3.75rem);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--wide);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    max-width: 18ch;
  }

  .summary {
    max-width: 32em;
    font-size: var(--step-1);
    line-height: 1.35;
    margin: 0;
  }

  /* Grid lines drawn with pseudo-elements so they can be traced on entrance. */
  .facts {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    margin: 0;
  }

  .facts div {
    position: relative;
    padding: 0.5rem 0.75rem 0.6rem;
  }

  .facts div::before,
  .facts div::after {
    content: '';
    position: absolute;
    background: var(--ink);
  }

  /* As before: the list draws the top and left edges, each cell its bottom and right. */
  .facts div::before {
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    transform-origin: left;
  }

  .facts div::after {
    top: 0;
    right: 0;
    bottom: 0;
    width: 1px;
    transform-origin: top;
  }

  .facts::before,
  .facts::after {
    content: '';
    position: absolute;
    z-index: 1;
    background: var(--ink);
  }

  .facts::before {
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    transform-origin: left;
  }

  .facts::after {
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    transform-origin: top;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js-motion) .facts div::before,
    :global(.js-motion) .facts div::after,
    :global(.js-motion) .facts::before,
    :global(.js-motion) .facts::after {
      transition: transform 500ms var(--ease-in-out);
      transition-delay: calc(var(--i, 0) * 60ms);
    }

    :global(.js-motion) .facts:not(.is-in) div::before,
    :global(.js-motion) .facts:not(.is-in)::before {
      transform: scaleX(0);
    }

    :global(.js-motion) .facts:not(.is-in) div::after,
    :global(.js-motion) .facts:not(.is-in)::after {
      transform: scaleY(0);
    }

    :global(.js-motion) .facts dt,
    :global(.js-motion) .facts dd {
      opacity: 0;
      transition: opacity 500ms var(--ease-out);
      transition-delay: calc(450ms + var(--i, 0) * 60ms);
    }

    :global(.js-motion) .facts.is-in dt,
    :global(.js-motion) .facts.is-in dd {
      opacity: 1;
    }
  }

  /* Reading progress, drawn as a scale bar along the top edge. */
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    height: 4px;
    background: repeating-linear-gradient(90deg, rgb(0 0 0 / 0.22) 0 5%, transparent 5% 10%);
    pointer-events: none;
  }

  .read-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }

  @supports (animation-timeline: scroll()) {
    .read-progress span {
      animation: read-progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes read-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  dt {
    font-size: var(--step--1);
    color: var(--graphite);
  }

  dd {
    margin: 0.1rem 0 0;
  }

  .project-body {
    display: grid;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .block-text {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .title-block {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      column-gap: clamp(2rem, 5vw, 5rem);
    }

    .facts {
      grid-column: 1 / -1;
    }

    /* Text sits in the right-hand column, like notes beside a drawing. */
    .block-text {
      margin-left: calc(7 / 12 * 100%);
      max-width: 28em;
    }
  }

  .project-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 1rem;
    margin-top: clamp(4rem, 10vw, 8rem);
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--ink);
  }

  .project-nav a {
    text-decoration: none;
  }

  .nav-label {
    display: block;
    font-size: var(--step--1);
    color: var(--graphite);
  }

  .nav-title {
    font-size: var(--step-1);
    font-weight: var(--heading-weight);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--wide);
  }

  .project-nav a:hover .nav-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .all {
    color: var(--graphite);
    text-decoration: underline !important;
  }

  .next {
    grid-column: 3;
    text-align: right;
  }

  @media (max-width: 767px) {
    .project-nav {
      grid-template-columns: 1fr 1fr;
    }

    .all {
      grid-row: 2;
      grid-column: 1 / -1;
    }

    .next {
      grid-column: 2;
    }
  }
</style>

<script>
  // Entrance motion: fade/rise once when an element enters the viewport,
  // text line by line, and the facts table traced. Only runs with html.js-motion.
  const root = document.documentElement;

  /** Wrap each word in a span and number the visual lines it falls on. */
  function splitLines(el: HTMLElement) {
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);
    for (const node of nodes) {
      const parts = node.textContent?.split(/(\s+)/) ?? [];
      const fragment = document.createDocumentFragment();
      for (const part of parts) {
        if (!part) continue;
        if (/^\s+$/.test(part)) {
          fragment.append(part);
        } else {
          const span = document.createElement('span');
          span.className = 'w';
          span.textContent = part;
          fragment.append(span);
        }
      }
      node.replaceWith(fragment);
    }
    let line = -1;
    let lastTop = -Infinity;
    el.querySelectorAll<HTMLElement>('.w').forEach((word) => {
      const top = word.offsetTop;
      if (top > lastTop + 2) {
        line += 1;
        lastTop = top;
      }
      word.style.setProperty('--line', String(line));
    });
    el.classList.add('is-split');
  }

  if (root.classList.contains('js-motion')) {
    (window as unknown as { __motionReady: boolean }).__motionReady = true;

    document
      .querySelectorAll<HTMLElement>('.block-text > p, .text-image .text > p')
      .forEach((p) => p.setAttribute('data-lines', ''));

    const targets = document.querySelectorAll<HTMLElement>('.enter, [data-lines], [data-facts]');
    document.fonts.ready.then(() => {
      document.querySelectorAll<HTMLElement>('[data-lines]').forEach(splitLines);

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.15 },
      );
      targets.forEach((el) => observer.observe(el));
    });
  }

  // Reading progress fallback where scroll timelines are not supported.
  const progress = document.querySelector<HTMLElement>('[data-read-progress]');
  if (progress && !CSS.supports('animation-timeline', 'scroll()')) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      progress.style.setProperty('--progress', String(max > 0 ? scrollY / max : 0));
      ticking = false;
    };
    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>
